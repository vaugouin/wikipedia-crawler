# User agent to crawl Wikimedia sites
WIKIMEDIA_USER_AGENT=Your user agent here

# Crawler concurrency (Phase 1 of doc/wikipedia-crawler-optimization.md)
# Number of concurrent page-fetch workers (network + parsing only; DB stays single-threaded)
WIKIPEDIA_CRAWLER_WORKERS=8
# Global cap on Wikimedia requests/sec across all workers (0 disables the cap)
WIKIPEDIA_CRAWLER_MAX_RPS=20

# Define variables
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAMESPACE=T_WC_

USER_TIMEZONE=Europe/Paris

